# ============================================================
# MMA Fighting Platform — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Django core settings
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True for local development, False for production
DEBUG=True

# Comma-separated list of allowed hostnames
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,mysite.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# Database
# ============================================================
# PostgreSQL (recommended for production):
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
# SQLite (development fallback — used if DATABASE_URL is not set):
#   DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# ============================================================
# Groq AI API
# ============================================================
# Obtain your API key from https://console.groq.com/
GROQ_API_KEY=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

# Model to use for AI responses (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Timeout in seconds for Groq API calls (default: 10)
GROQ_TIMEOUT=10

# ============================================================
# External News API
# ============================================================
# API key for the news data provider (e.g. NewsAPI, RapidAPI SportNews)
NEWS_API_KEY=cfef60c91a2541178613b3f34bd2e416
# GNews API key — get free key at https://gnews.io (100 req/day free)
# Works server-side unlike NewsAPI free plan
GNEWS_API_KEY=4403ac3419b3d50fcaa60ad03fca4b1c

# ============================================================
# External Sports API
# ============================================================
# API key for the sports/events data provider (e.g. RapidAPI MMA)
SPORTS_API_KEY=your-sports-api-key-here

# ============================================================
# Redis (optional — used for Celery task queue and caching in production)
# ============================================================
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# Email (production only)
# ============================================================
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@mmaplatform.com
# SERVER_EMAIL=server@mmaplatform.com

# ============================================================
# Admin email alerts (production only)
# ============================================================
# Semicolon-separated list of name:email pairs
# Example: ADMINS=Admin Name:admin@example.com;Other Admin:other@example.com
# ADMINS=Admin Name:admin@example.com
